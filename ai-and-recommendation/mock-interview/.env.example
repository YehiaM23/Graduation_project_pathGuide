# OpenAI
OPENAI_API_KEY=sk-REPLACE_WITH_OPENAI_API_KEY

# LiveKit
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET

# QUICK_INTERVIEW — smoke-test mode. When truthy (1/true/yes/on), the agent skips the real
# interview: it just greets the candidate, then writes a canned "Test Passed" report to
# reports/ and uploads it to the PathGuide API (when applicationId + the vars below are set).
# Leave unset/empty for normal interviews.
QUICK_INTERVIEW=false

# PathGuide .NET API — used to persist the generated interview report into
# internship_applications.mock_interview_report. Both must be set for upload;
# if either is empty, the report is only saved to the local reports/ folder.
# AgentApiKey must match MockInterview:AgentApiKey in the .NET appsettings.
PATHGUIDE_API_URL=https://your-api-host
PATHGUIDE_AGENT_API_KEY=REPLACE_WITH_MOCK_INTERVIEW_AGENT_API_KEY
